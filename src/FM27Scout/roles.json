{
  // FM27 Scout role profiles. Our own weights. Edit freely; the app copies this file to
  // %APPDATA%\FM27Scout\roles.json on first run and reads that copy (delete it to get the defaults back).
  //
  // score = sum(weight * attribute(1-20)) / sum(weight)  -> scaled to 0-100
  //         then multiplied by the familiarity factor for the best of the role's positions.
  "tiers": { "key": 3, "important": 2, "useful": 1 },

  // Position rating (1-20) -> multiplier, following FM's bands: 20 Natural, 15+ Accomplished, 10+ Competent,
  // 5+ Unconvincing, below that Awkward. First rule whose "min" is <= rating wins.
  "familiarity": [
    { "min": 18, "factor": 1.00 },
    { "min": 15, "factor": 0.95 },
    { "min": 10, "factor": 0.85 },
    { "min": 5,  "factor": 0.65 },
    { "min": 1,  "factor": 0.50 }
  ],

  // Potential role score ("at PA"): the expected CA gain is (PA - CA) * ageFactor, adjusted by the player's development
  // outlook (personality), then spread over the attributes that cost the most CA for his position group (fitted from your
  // save at every load; physicals grow less after 23). ageFactor = first rule whose maxAge >= his age.
  "potentialAge": [
    { "maxAge": 20, "factor": 1.00 },
    { "maxAge": 23, "factor": 0.80 },
    { "maxAge": 26, "factor": 0.50 },
    { "maxAge": 29, "factor": 0.20 },
    { "maxAge": 99, "factor": 0.00 }
  ],

