{
  // FM27 memory layout, keyed by the ProductVersion of game_plugin.dll (the native game engine).
  // All "Rva" values are relative to the game_plugin.dll base address (ASLR-safe).
  // Person offsets are relative to the person pointer (what the game's own lists point at = the object's vtable slot).
  // Player offsets are NEGATIVE: the player-specific block (positions, attributes, CA/PA, height) sits just before the person pointer.
  // Status of each field is documented in README.md ("confirmed" = checked on several known players).
  "builds": {
    "27.0.0+2493426": {
      "module": "game_plugin.dll",
      "steamBuildId": 26340721,

      "personDb": {
        "rootRva": "0x57056E0",   // static pointer -> database object
        "vectorBegin": "0x138",   // std::vector<Person*> of ALL people (players, staff, retired...)
        "vectorEnd": "0x140",
        // other static paths to the same master list. FM fills them at different times (0x57056E0 was empty after a restart
        // on 10/11/2026 while 0x56F7070 had all 427k people), so the reader uses whichever is populated.
        "alternatives": [
          { "rootRva": "0x56F7070", "vectorBegin": "0x6E0", "vectorEnd": "0x6E8" },
          { "rootRva": "0x56F7078", "vectorBegin": "0x4C0", "vectorEnd": "0x4C8" }
        ]
      },
      "gameDateRva": "0x5706018", // confirmed: current in-game date (Wed 4/2/2037 = day 35); u16 day in low 9 bits, u16 year
      "playerVtableRva": "0x4D29758", // person pointer's first qword == module+this  => it is a player (~140k)
      // A second player class (~2.9k, e.g. Jacob Greaves): same person fields, player block 0xF8 bytes further back.
      "extraPlayerClasses": [ { "vtableRva": "0x4F77F38", "shift": "-0xF8" } ],
      "humanManagerVtableRva": "0x4CC28D8", // human manager(s): e.g. "Paul Manghan"; club via person.contract -> team -> club
      // contract.squadStatus values. Confirmed against UI: 2, 3, 17. Others inferred from who has them.
      "squadStatusNames": {
        "1": "Star Player", "2": "Important Player", "3": "Regular Starter", "4": "Squad Player", "5": "Fringe Player?",
        "7": "Backup?", "10": "Hot Prospect?", "11": "Breakthrough Prospect?", "13": "Youngster?", "15": "First-Choice GK?",
        "17": "Domestic Cup Goalkeeper", "20": "Backup GK?"
      },

      "person": {
        "uid": "0xC",              // u32 FM unique ID (Haaland = 29179241)
        "fullName": "0x40",        // FMString* (only set when full name differs, e.g. "Erling Braut Haaland")
        "firstNameEntry": "0x50",  // -> name-table entry -> FMString*
        "lastNameEntry": "0x58",
        "nation": "0x68",          // Nation* (nation +0x18 = name)
        "personality": "0x70",     // 8 bytes, 1-20 (hidden personality attributes; order unconfirmed)
        "birthCity": "0x80",       // City* (city +0x18 = name)
        "dateOfBirth": "0x88",     // u16 day-of-year (1-based), u16 year
        "club": "0x108",           // PREVIOUS club (staff: Reiziger->Hannover, Wright->Man City, Vukcevic->Buducnost per their history). Current club = contract chain.
        "contract": "0xA8",        // Contract* for the current club (null if none)
        "relations": "0x78",       // -> object with std::vector of 16-byte entries {target*, ?, u8 kind (+0xA), u8 relation (+0xB), u8 strength (+0xC)}
                                   // kind 8 = nation, 1 = club, 3 = person. nation+relation 9 = other nationality (Musiala: England, Nigeria);
                                   // club+relation 3/4 = favoured club (Haaland: Leeds, Viking); 0x48 = former club; nation 0x46 = played in
        "flags": "0x19",           // flag byte
        "femaleBit": 4             // bit set = female (100% of women's-league players, 0.2% elsewhere)
      },
      "nation": { "name": "0x18", "code": "0x28", "nationality": "0x30" },
      "club": { "name": "0xC0", "shortName": "0xC8", "reputation": "0x168" }, // reputation u16 0-10000 (Real Madrid 9750, Bristol Rovers 5750)
      "contract": {
        "team": "0x10",          // Team* (first team / B team etc.)
        "weeklyWage": "0x20",    // u32, GBP per week (inside UI wage range for all 3 test players)
        "startDate": "0x44",     // date (day field has flags in upper bits)
        "expiryDate": "0x48",    // date, confirmed (30/6/2038, 30/6/2037, 30/6/2040)
        "squadStatus": "0x54",   // u8, see squadStatusNames
        "job": "0x26"            // u8 job code, see jobNames
      },
      "team": { "club": "0x30", "competition": "0x50", "competitionName": "0x48", "competitionNation": "0x60" },

      "player": {
        "blockStart": "-0x288",
        "positions": "-0x138",       // 15 bytes, 1-20 position ratings
        "attributes": "-0x129",      // 54 bytes, 1-100 scale (UI shows value/5)
        "height": "-0x5A",           // u8 cm
        "currentAbility": "-0x24",   // s16 1-200
        "potentialAbility": "-0x22", // s16 1-200 (negative = range, none seen in this save)
        "commonName": "-0x198",
        "careerStats": "-0x178",     // pointer to career stats object (verified on 5 players vs UI career totals)
        "careerGoals": "0x6",        // u16 in that object
        "careerApps": "0xE",         // u16 in that object
        "homeReputation": "-0x2A",   // u16 0-10000 (likely: Bristol Rovers players ~5000)
        "currentReputation": "-0x28",// u16 0-10000
        "worldReputation": "-0x26",  // u16 0-10000 (Haaland 9852, Bristol Rovers players ~2500)      // FMString* known-as name, null if none (Yamal -> "Lamine Yamal")
        "value": "-0x54"             // u32 GBP. Inside UI range for Yamal, Urbig, Ortiz; Verbruggen 25.2M vs UI 19.5-25M; Haaland 300M (Not for Sale)
      },

      // Order from known players: GK Verbruggen; DC Cubarsi/Huijsen/Yoro (idx3); DL+WBL Andueza; DR+WBR Javier Ortiz; DM/MC/AMC Bellingham; AMR Yamal; ST Haaland.
      // idx1 is 1 for everyone -> Sweeper (legacy). Confirmed by Javier Ortiz screenshot (DR 20, WBR 15, DL 7).
      "positionNames": [ "GK", "SW", "DL", "DC", "DR", "DM", "ML", "MC", "MR", "AML", "AMC", "AMR", "ST", "WBL", "WBR" ],

      // 54 attributes, raw 1-100 (UI = round(raw/5)). Order = FM's classic internal order.
      // Confirmed against UI for Haaland, Yamal, Verbruggen: all 36 outfield + Handling, CommandOfArea, OneOnOnes, Eccentricity, RushingOut, Punching.
      // All 13 GK attributes confirmed with Urbig screenshot. Only the 5 hidden attributes (41,44,47,48,49) are named from the order.
      "attributeNames": [
        "Crossing", "Dribbling", "Finishing", "Heading", "LongShots", "Marking", "OffTheBall", "Passing", "Penalties", "Tackling", "Vision",
        "Handling", "AerialReach", "CommandOfArea", "Communication", "Kicking", "Throwing",
        "Anticipation", "Decisions", "OneOnOnes", "Positioning", "Reflexes", "FirstTouch", "Technique", "LeftFoot", "RightFoot",
        "Flair", "Corners", "Teamwork", "WorkRate", "LongThrows", "Eccentricity", "RushingOut", "Punching",
        "Acceleration", "FreeKicks", "Strength", "Stamina", "Pace", "JumpingReach", "Leadership", "Dirtiness", "Balance", "Bravery",
        "Consistency", "Aggression", "Agility", "ImportantMatches", "InjuryProneness", "Versatility", "NaturalFitness", "Determination",
        "Composure", "Concentration"
      ],
      // Order solved from 12 UI personality labels (players + staff): see docs/ground-truth-brr.md
      "personalityNames": [ "Adaptability", "Ambition", "Loyalty", "Pressure", "Professionalism", "Sportsmanship", "Temperament", "Controversy" ],
      "staffVtableRva": "0x4D8DE78",
      // contract.job codes seen in the UI: 1 player, 2 Coach, 12 Physio, 14 Scout, 16 Manager, 20 Assistant Manager
      "jobNames": { "1": "Player", "2": "Coach", "12": "Physio", "14": "Scout", "16": "Manager", "20": "Assistant Manager" }
    }
  }
}











