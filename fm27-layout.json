        "currentAbility": "-0x24",   // s16 1-200
        "potentialAbility": "-0x22", // s16 1-200 (negative = range, none seen in this save)
        "value": "-0x54"             // u32 GBP, tentative: Yamal 221.9M (UI 202-222M), Verbruggen 25.2M (UI 19.5-25M), Haaland exactly 300M (Not for Sale)
